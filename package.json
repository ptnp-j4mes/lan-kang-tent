{
  "name": "lan-kang-tent",
  "private": true,
  "version": "0.1.0",
  "description": "CampThai Map — แพลตฟอร์มค้นหาและรีวิวลานกางเต็นท์ในประเทศไทย",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "build": "bun run --filter '*' build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @ckt/db generate",
    "db:migrate": "bun run --filter @ckt/db migrate",
    "db:seed": "bun run --filter @ckt/db seed",
    "db:studio": "bun run --filter @ckt/db studio"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "bun@1.3.13"
}
